# ==============================================================================
# Voice Era Tech LLC - Environment Configuration Reference
# ==============================================================================
# For Vercel Deployment:
# Add these variables under your Vercel Project Settings -> Environment Variables.
#
# For Local Development:
# Copy this file to `.env.local` and populate the values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Turso SQLite Database (Production & Vercel)
# ------------------------------------------------------------------------------
# Create a free Turso database:
# 1) Install Turso CLI: `curl -sSfL https://get.tur.so/install.sh | bash` (or via brew/winget)
# 2) Create db: `turso db create voice-era-db`
# 3) Get URL: `turso db show voice-era-db --url`
# 4) Create Token: `turso db tokens create voice-era-db`
#
# When configured, inquiries, KYC onboarding records, and logs are persisted in Turso cloud.
# If omitted locally, the app gracefully falls back to local SQLite file storage (data/voice_era_tech.db).
TURSO_DATABASE_URL=libsql://voice-era-db-[your-org].turso.io
TURSO_AUTH_TOKEN=your_turso_jwt_auth_token_here

# ------------------------------------------------------------------------------
# 2. Administrative Security & Portal Authentication
# ------------------------------------------------------------------------------
# Used to authenticate into /admin portal
ADMIN_EMAIL=admin@voiceeratech.com
ADMIN_PASSWORD=voiceera2026
ADMIN_JWT_SECRET=your_secure_random_jwt_secret_here

# ------------------------------------------------------------------------------
# 3. Live Email Dispatch (SMTP Configuration)
# ------------------------------------------------------------------------------
# When configured, carrier KYC PDFs and customer inquiries are dispatched live to compliance desks.
# When unconfigured, submissions and certified PDFs are safely archived in Turso and available in /admin.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=info@voiceeratech.com
SMTP_PASS=your_smtp_password_here
SMTP_FROM="Voice Era Tech LLC" <no-reply@voiceeratech.com>

# ------------------------------------------------------------------------------
# 4. Routing & Target Inboxes
# ------------------------------------------------------------------------------
SUPPORT_EMAIL=support@voiceeratech.com
KYC_EMAIL=kyc@voiceeratech.com
NEXT_PUBLIC_APP_URL=https://voiceeratech.com
